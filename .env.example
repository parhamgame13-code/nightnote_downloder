# ============================================================
# نمونه‌ی فایل تنظیمات NightDownloaderBot
# کپی کن به .env و فقط مقادیر ضروری رو پر کن:
#   cp .env.example .env
#
# ⚠️ BOT_TOKEN تنها متغیر اجباریه؛ بقیه پیش‌فرض منطقی دارن.
# ⚠️ این فایل رو هرگز کامیت/اشتراک نکن (تو .gitignore هست).
# ============================================================

# ---------- تلگرام (اجباری) ----------
# توکن بات از @BotFather
BOT_TOKEN=123456:ABC-your-token-here

# یوزرنیم بات (بدون @) - فقط برای نمایش/منطق دستورهای گروهی
BOT_USERNAME=NightDownloaderBot

# کانال/گروپ‌های معرفی‌شده در پیام‌ها (بدون @)
CHANNEL_USERNAME=NightNote_official

# ادمین‌های بات - آی‌دی عددی تلگرام، جدا با کاما
# (آی‌دی خودت رو از @userinfobot بگیر)
ADMIN_IDS=123456789

# گروپ‌های مجاز (اگه خالی باشه همه‌ی گروپ‌ها) - جدا با کاما
ALLOWED_GROUP_IDS=

# ---------- کوکی‌های لاگین (اختیاری) ----------
# مسیر فایل کوکی Netscape-format اینستاگرام - بدون این، فقط پست‌های عمومی
# اینستاگرام دانلود می‌شه. هر چند هفته باید از مرورگر لاگین‌شده export بشه.
# (بزرگ‌ترین مزیتش: پست‌های خصوصی‌شده بعداً + نرخ خطای کمتر)
#INSTAGRAM_COOKIE_FILE=cookies/instagram.txt

# کوکی یوتیوب - فقط اگه IP سرورت از سمت یوتیوب 403 گرفت (fallback خودکار
# با player_clientهای جایگزین معمولاً کافیه)
#YOUTUBE_COOKIE_FILE=cookies/youtube.txt

# کلید API اکانت FileLu (پولی) - بدون این، لینک‌های filelu پشتیبانی نمی‌شن
#FILELU_API_KEY=

# ---------- Redis ----------
#REDIS_URL=redis://localhost:6379/0
# دیتابیس Redis برای نتیجه‌ی تسک‌های Celery
#REDIS_DB_JOBS=2

# ---------- دیتابیس ----------
# SQLite (پیش‌فرض - برای شروع کافیه):
#DATABASE_URL=sqlite+aiosqlite:///./bot.db
# PostgreSQL (پیشنهادی برای مقیاس واقعی - همون که تو docker-compose ست می‌شه):
#DATABASE_URL=postgresql+asyncpg://downloader:secure_password_123@localhost/downloader_bot

# ---------- Celery (اختیاری) ----------
# اگه None باشه از REDIS_URL استفاده می‌شه
#CELERY_BROKER_URL=
#CELERY_RESULT_BACKEND=

# ---------- فایل‌ها و محدودیت‌ها ----------
# پوشه‌ی فایل‌های موقت دانلود
#TEMP_DIR=/tmp/downloader_bot

# سقف حجم فایل تحویلی (مگابایت) - تا 2000 با Local Bot API Server
#MAX_FILE_SIZE_MB=2000
# برای لینک‌های فایل مستقیم، بالاتر از این حجم قبل از دانلود تاییدیه می‌گیریم
#MAX_WARN_SIZE_MB=700

# سقف روزانه به‌ازای هر کاربر (دو مسیر جدا حساب می‌شن)
#MAX_DAILY_DOWNLOADS=50
#MAX_DAILY_DIRECT_UPLOADS=50

# سقف دانلود همزمان (لیمیتر مشترک بین همه‌ی ورکرها؛ با pool=solo تک‌ورکر
# عملاً یکی-یکی اجرا می‌کنه - برای موازی‌سازی واقعی چند replica ورکر بالا بیار)
#MAX_CONCURRENT_DOWNLOADS=100

# تایم‌اوت کل یه دانلود (ثانیه)
#DOWNLOAD_TIMEOUT=1800

# ---------- Local Bot API Server ----------
# برای فایل‌های تا 2 گیگ باید سرور محلی telegram-bot-api (پورت 8081) بالا باشه.
# اگه نداری، USE_LOCAL_BOT_API_SERVER=false بذار (سقف آپلود بات به 50MB برمی‌گرده!)
#USE_LOCAL_BOT_API_SERVER=true
#LOCAL_BOT_API_URL=http://localhost:8081

# api_id/api_hash برای اجرای خودِ سرویس telegram-bot-api (تو docker-compose).
# جفتِ زیر همون جفتِ منتشرشده‌ی Telegram Desktop تو سورس باز خود تلگرامه و
# همه‌جای اینترنت پخشه - کار می‌کنه؛ ولی اگه خواستی جفت اختصاصی داشته باشی
# از my.telegram.org رایگان می‌شه گرفت (ریسک محدودیت کمتر).
TELEGRAM_API_ID=17349
TELEGRAM_API_HASH=344583e45741c457fe1862106095a5eb

# تایم‌اوت آپلود/دانلود aiogram با Bot API (ثانیه) - برای فایل‌های حجیم
#BOT_SESSION_TIMEOUT=1800
# Local Bot API Server فایل‌ها رو برای همیشه زیر این مسیر نگه می‌داره؛
# پاک‌سازیش با ماست (تسک cleanup_temp_files)
#BOT_API_LOCAL_FILES_DIR=/var/lib/telegram-bot-api
#BOT_API_LOCAL_FILES_MAX_AGE_HOURS=2
# تایم‌اوت get_file برای فایل‌های فورواردی حجیم (ثانیه)
#TELEGRAM_GET_FILE_TIMEOUT_SECONDS=1200

# ---------- لینک دانلود مستقیم ----------
# اگه روشن کنی، وب‌سرور اختصاصی (webserver/direct_link_server.py) هم باید بالا باشه
#DIRECT_LINK_ENABLED=false
# آدرس عمومی که فایل‌ها ازش سرو می‌شن (بدون / آخر)
#DIRECT_LINK_PUBLIC_URL=https://dl.example.ir
#DIRECT_LINK_DIR=/var/lib/downloader_bot/direct_links
#DIRECT_LINK_PORT=8090
# عمر لینک مستقیم (ثانیه) - پیش‌فرض ۴ ساعت؛ کاربر می‌تونه از دکمه تمدید کنه
#DIRECT_LINK_EXPIRE_SECONDS=14400

# ---------- نگه‌داری و نگهبان دیسک ----------
# حذف خودکار تاریخچه‌ی jobهای قدیمی‌تر از این تعداد روز (۰ = هرگز حذف نشه)
#JOB_RETENTION_DAYS=90

# آستانه‌های نگهبان فضای دیسک (درصد پر بودن):
#DISK_WARN_PERCENT=85       # هشدار به ادمین‌ها
#DISK_CRITICAL_PERCENT=95   # بستن موقت دانلودهای جدید
#DISK_RESUME_PERCENT=80     # برگشت به عادی (هیسترزیس)

# ---------- آپدیت خودکار ----------
# آپدیت yt-dlp/curl_cffi هر ۶ ساعت توسط beat. false کن اگه نسخه‌ها باید پین بمونن
#AUTO_UPDATE_YTDLP=true

# ---------- لاگینگ ----------
#LOG_LEVEL=INFO
#LOG_FILE=logs/bot.log
